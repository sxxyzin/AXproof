# AX Proof 환경변수 예시
# 로컬: 이 파일을 .env 로 복사해 값을 채우세요 (.env 는 GitHub에 올라가지 않아요)
# Vercel: Project Settings → Environment Variables 에 같은 이름으로 넣고 Redeploy

# ── AI (기본: OpenAI) ───────────────────────────────
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.6
OPENAI_QUICK_MODEL=gpt-5.6
OPENAI_DEEP_MODEL=gpt-5.6
# 사용자 1명당 하루 실제 AI 호출 수 (대화·판단 분석·리포트 포함, UTC 기준)
AXP_AI_DAILY_LIMIT=120
# 지식 수집 허용 호스트(쉼표 구분, 배포 시 명시한 호스트만 수집)
AXP_FETCH_ALLOWED_HOSTS=
# (선택) Claude도 쓰려면
ANTHROPIC_API_KEY=

# ── 보안 (배포 시 필수) ─────────────────────────────
# 로그인 토큰 서명 키: 긴 무작위 문자열
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AXP_SECRET=
# 운영진 가입 코드 (로컬 기본값: axproof-admin)
AXP_ADMIN_CODE=
# 둘러보기(데모 계정) 허용: 1=허용, 0=끔 (로컬 기본 허용, 배포 기본 끔)
AXP_DEMO=

# ── 데이터베이스 (배포 시: Supabase) ─────────────────
# 비워 두면 로컬은 web/data/db.json 파일에 저장
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 로컬 서버 포트
PORT=3000
